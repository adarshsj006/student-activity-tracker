{
  "name": "student-activity-tracker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "npm install --prefix frontend",
    "backend": "cd backend && python -m uvicorn main:app --reload",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n backend,frontend -c green,cyan \"npm:backend\" \"npm:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}